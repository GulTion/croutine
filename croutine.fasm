format ELF64

CRO_NUMS = 10
CRO_STACK_SIZE = 4096
section '.text' executable
public cro
cro:
; save real stack pointers
    mov [real_rbp], rbp
    mov [real_rsp], rsp
; save function pointer
    mov r11, rdi
; swtich registors
    mov rdi, rsi
    mov rsi, rdx
    mov rdx, rcx
    mov rcx, r8
    mov r8, r9

; make new stack
    mov rax, [cro_stack_current] ; i
    inc rax
    imul rax, rax, CRO_STACK_SIZE
    lea rsp, [cro_stack + rax]
    mov rbp, rsp

; call function
    call r11
; restore main's original stack pointers
    mov rsp, [real_rsp]
    mov rbp, [real_rbp]
    ret


exit:
    mov rdi, 0
    mov rax, 60
    syscall

section '.data' writeable
msg: db "Hello C, i am croutine.s",0, 10
msg_len = $ - msg

section '.bss' writeable align 16
real_rsp:
    rq 1
real_rbp:
    rq 1
cro_stack_current:
    rq 1
cro_busy:
    rb CRO_NUMS
cro_rsp_arr:
    rq CRO_NUMS
cro_rbp_arr:
    rq CRO_NUMS
cro_rip_arr:
    rq CRO_NUMS
public cro_stack
cro_stack:
    rb CRO_NUMS * CRO_STACK_SIZE
