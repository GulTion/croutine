format ELF64

CRO_NUMS = 10
CRO_STACK_SIZE = 4096
section '.text' executable
public cro_init
cro_init:
    mov QWORD [cro_stack_current], 0
    ; save real stack pointers
    mov [real_rbp], rbp
    mov [real_rsp], rsp
    call cro_stack_current_begin
    ; point to new stack frame
    mov rbp, rax
    mov rsp, rbp

    ; push ret addr from real_rsp into rsp
    mov rax, [real_rsp]
    push rax
    ret


; Z = X + i*Y
cro_stack_current_begin:
    push rdi
    mov rdi, [cro_stack_current] ; i
    inc rdi
    imul rax, rdi, CRO_STACK_SIZE
    lea rax, [cro_stack + rax]
    pop rdi
    ret





public cro
cro:
; save real stack pointers
    mov [real_rbp], rbp
    mov [real_rsp], rsp
; swtich registors
    push rdi
    mov rdi, rsi
    mov rsi, rdx
    mov rdx, r10
    mov r10, r8
    mov r8, r9
    pop r9
; make new stack
    call cro_stack_current_begin
    mov rbp, rax
    mov rsp, rbp

; push ret addr from real_rsp into rsp

    call r9
    mov rax, [real_rsp]
    push QWORD [rax]
    ret

cro_reg_switch:
    ; number of arg : rsi



exit:
    mov rdi, 0
    mov rax, 60
    syscall

section '.data' writeable
msg: db "Hello C, i am croutine.s",0, 10
msg_len = $ - msg

section '.bss' writeable align 16
real_rsp:
    rq 1
real_rbp:
    rq 1
cro_stack_current:
    rq 1
cro_busy:
    rb CRO_NUMS
cro_rsp_arr:
    rq CRO_NUMS
cro_rbp_arr:
    rq CRO_NUMS
cro_rip_arr:
    rq CRO_NUMS
public cro_stack
cro_stack:
    rb CRO_NUMS * CRO_STACK_SIZE
